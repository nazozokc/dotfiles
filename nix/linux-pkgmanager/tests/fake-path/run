#!/usr/bin/env bash
# tests/fake-path/run — 5 pm すべてのコマンド生成と差分計算を検証する
#
# ホストが Arch でも apt / dnf / zypper / yum の経路を検証できる唯一の手段。
# PATH を差し替えてスタブだけを解決させ、生成したコマンドと引数、
# および不足パッケージの判定結果を突き合わせる。
#
# nlp は coreutils / gnugrep / gnused を PATH の先頭に足した状態で動く。
# 引数、pm 名 (pacman / apt-get / apt-mark / dnf / rpm / zypper / yum / sudo)
# は closure に入っていないので、末尾に足したスタブディレクトリが優先される。
#
# 使い方:
#   NLP=/path/to/nlp tests/fake-path/run
#
# NLP_HOSTILE は任意。宣言の検証 (nix/lib/declared.nix) を意図的に
# 迂回して作った nlp で、「検証が万一抜けても実行は起きない」ことを確かめる
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
stub="$here/stub"
nlp="${NLP:-}"
hostile="${NLP_HOSTILE:-}"

fail=0
total=0

ok() {
  total=$((total + 1))
  printf '  \033[32mok\033[0m   %s\n' "$1"
}

ng() {
  total=$((total + 1))
  fail=$((fail + 1))
  printf '  \033[31mFAIL\033[0m %s\n' "$1"
  shift
  while [ $# -gt 0 ]; do
    printf '       %s\n' "$1"
    shift
  done
}

section() {
  printf '\n\033[1m%s\033[0m\n' "$1"
}

# その pm が実際に使うスタブだけ PATH の先頭へ足す。
# (全部入れると detect が apt を先に検出してしまい、pm ごとの検証にならない)
make_path() {
  local dir="$1" pm="$2" b
  mkdir -p "$dir"
  case "$pm" in
    pacman) local set="pacman sudo" ;;
    apt) local set="apt-get apt-mark sudo" ;;
    dnf | zypper | yum) local set="$pm rpm sudo" ;;
    *) local set="$pm" ;;
  esac
  for b in $set; do
    ln -sf "$stub" "$dir/$b"
  done
  printf '%s' "$dir"
}

# run <stub-dir> <subcommand> [env=値 ...]
#   呼び出し記録 → $calls / 出力 → $out / 終了コード → $rc
run() {
  local dir="$1" sub="$2"
  shift 2
  local log
  log="$(mktemp)"
  out="$(env PATH="$dir" STUB_LOG="$log" "$@" "$nlp" "$sub" 2>&1)"
  rc=$?
  calls="$(cat "$log" 2>/dev/null)"
  rm -f "$log"
}

# run_args <stub-dir> <subcommand> [nlp 引数 ...]
#   run と同じだが、command 以降は env 変数ではなく nlp の引数として渡す
run_args() {
  local dir="$1" sub="$2"
  shift 2
  local log
  log="$(mktemp)"
  out="$(env PATH="$dir" STUB_LOG="$log" "$nlp" "$sub" "$@" 2>&1)"
  rc=$?
  calls="$(cat "$log" 2>/dev/null)"
  rm -f "$log"
}

# run_hostile <stub-dir> <subcommand> [env=値 ...]
#   run と同じだが hostile 版 nlp を呼ぶ。標識ファイルが残っていないかも見る
run_hostile() {
  local dir="$1" sub="$2"
  shift 2
  local log
  log="$(mktemp)"
  rm -f PWNED
  out="$(env PATH="$dir" STUB_LOG="$log" "$@" "$hostile" "$sub" 2>&1)"
  rc=$?
  calls="$(cat "$log" 2>/dev/null)"
  rm -f "$log"
}

# run_split <stub-dir> <subcommand> [env=値 ...]
#   run と同じだが標準出力と標準エラーを分けて取る。
#   adopt は「標準出力が宣言そのもの」という契約があるので、混ぜると検査できない。
#   結果 → $out (stdout) / $err (stderr) / $calls / $rc
run_split() {
  local dir="$1" sub="$2"
  shift 2
  local log errfile
  log="$(mktemp)"
  errfile="$(mktemp)"
  rm -f PWNED
  out="$(env PATH="$dir" STUB_LOG="$log" "$@" "$nlp" "$sub" 2>"$errfile")"
  rc=$?
  calls="$(cat "$log" 2>/dev/null)"
  err="$(cat "$errfile" 2>/dev/null)"
  rm -f "$log" "$errfile"
}

if [ -z "$nlp" ] || [ ! -x "$nlp" ]; then
  printf '  \033[31mFAIL\033[0m nlp が無い: %s\n' "${nlp:-<未設定>}"
  printf '       NLP=/nix/store/...-nlp/bin/nlp を渡すこと\n'
  exit 1
fi

d="$(mktemp -d)"

# ===========================================================================
section 'pacman — 不足判定'
#   declare は man-db bash-completion。
#   pacman -T は不足名のみを stdout に出し rc=127 で終わる
# ===========================================================================
p="$(make_path "$d/pacman" pacman)"
run "$p" diff STUB_STDOUT='man-db' STUB_RC=127 STUB_STDERR='ignored'

if printf '%s' "$calls" | grep -Fqx 'pacman -T bash-completion man-db'; then
  ok 'pacman -T に宣言パッケージを渡す'
else
  ng 'pacman -T の引数' "期待: pacman -T bash-completion man-db" "実際: $calls"
fi

if printf '%s' "$out" | grep -qE 'missing +1'; then
  ok '不足 1 件として判定'
else
  ng '不足件数' "期待: missing 1 / 実際: $out"
fi

if printf '%s' "$out" | grep -qE '^ +- man-db$'; then
  ok '不足パッケージ名 (man-db) を表示'
else
  ng '不足パッケージ名' "実際: $out"
fi

if printf '%s' "$out" | grep -qE '^ +- bash-completion$'; then
  ng '充足済みを含めない' "bash-completion が不足扱い: $out"
else
  ok '充足済み (bash-completion) は不足に入らない'
fi

if [ "$rc" -eq 0 ]; then
  ok 'pacman -T が rc=127 を返しても異常終了しない'
else
  ng 'rc=127 の扱い' "期待: 0 / 実際: $rc" "$out"
fi

run "$p" diff STUB_STDOUT='' STUB_RC=0
if printf '%s' "$out" | grep -qE 'missing +0'; then
  ok '全て導入済みなら不足 0'
else
  ng '不足 0 件' "実際: $out"
fi

# ===========================================================================
section 'pacman — apply / update'
# ===========================================================================
run "$p" apply STUB_STDOUT='man-db' STUB_RC=127

if printf '%s' "$calls" | grep -Fqx 'sudo -v'; then
  ok '先に sudo -v を実行'
else
  ng 'sudo -v' "実際: $calls"
fi

if printf '%s' "$calls" | grep -Fqx 'sudo pacman -S --needed --noconfirm man-db'; then
  ok '不足分だけを pacman -S に渡す'
else
  ng 'install コマンド' "期待: sudo pacman -S --needed --noconfirm man-db" "実際: $calls"
fi

if printf '%s' "$out" | grep -qF 'sudo pacman -S --needed --noconfirm man-db'; then
  ok '実行前にコマンドを提示'
else
  ng 'コマンド提示' "実際: $out"
fi

# 不足判定のための pacman -T は必ず走る (それ自体は副作用がない)。
# 走ってよいのは照会だけ。pacman -S / sudo が出ていたら副作用がある
run "$p" apply STUB_STDOUT='' STUB_RC=0
if [ -z "$calls" ]; then
  ok '不足 0 なら install / sudo を呼ばない'
else
  if printf '%s' "$calls" | grep -qvFqx 'pacman -T bash-completion man-db'; then
    ng '不足 0 のとき副作用なし' "照会以外が呼ばれた: $calls"
  else
    ok '不足 0 なら install / sudo を呼ばない (照会のみ)'
  fi
fi

run "$p" update STUB_STDOUT='man-db' STUB_RC=127
if printf '%s' "$calls" | grep -Fqx 'sudo pacman -Syu --noconfirm'; then
  ok 'pacman -Syu を実行'
else
  ng 'update コマンド' "実際: $calls"
fi
if printf '%s' "$calls" | grep -Fq 'sudo pacman -S --needed --noconfirm'; then
  ok 'update 後に不足分を補う'
else
  ng 'update 後の install' "実際: $calls"
fi
if [ "$(printf '%s' "$calls" | grep -cF 'sudo -v')" -eq 2 ]; then
  ok 'sudo -v は update と install で 1 回ずつ (計2)'
else
  ng 'sudo -v の回数' "期待: 2 / 実際: $calls"
fi

# ===========================================================================
section 'apt — 不足判定は apt-get --simulate の Inst 行から'
#   declare は man-db bash-completion bat
# ===========================================================================
p="$(make_path "$d/apt" apt)"
run "$p" diff STUB_STDOUT='NOTE: This is only a simulation!
Inst bash-completion (1:2.3-1)
Inst bat (0.25.0-2)
Conf man-db (2.11.1-2)'

# 宣言は sort -u を通るので、pm コマンドに渡るパッケージ名は常にソート済み。
# (packages/apt.nix の宣言順そのままではない点に注意)
if printf '%s' "$calls" | grep -Fqx 'apt-get install --simulate --no-install-recommends -o Debug::NoLocking=1 bash-completion bat man-db'; then
  ok 'apt-get install --simulate に宣言を渡す (ソート済み)'
else
  ng 'simulate の引数' "実際: $calls"
fi

if printf '%s' "$calls" | grep -Fqx 'apt-mark showmanual'; then
  ok '明示導入は apt-mark showmanual'
else
  ng 'explicit コマンド' "実際: $calls"
fi

if printf '%s' "$out" | grep -qE 'missing +2'; then
  ok 'Inst 行 2 件だけを不足として数える (NOTE / Conf は除外)'
else
  ng '不足件数' "期待: 2 / 実際: $out"
fi

if printf '%s' "$out" | grep -qE '^ +- bash-completion$' && printf '%s' "$out" | grep -qE '^ +- bat$'; then
  ok '不足名をそのまま表示'
else
  ng '不足名' "実際: $out"
fi

if printf '%s' "$out" | grep -qE '^ +- man-db$'; then
  ng '導入済みを不足にしない' "man-db が不足扱い: $out"
else
  ok 'Inst 行の無い man-db は不足に入らない'
fi

run "$p" apply STUB_STDOUT='Inst man-db (2.11.1-2)
Inst bash-completion (1:2.3-1)'
if printf '%s' "$calls" | grep -Fqx 'sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends bash-completion man-db'; then
  ok '不足だけを apt-get install に渡す'
else
  ng 'install コマンド' "実際: $calls"
fi

# 2 本のコマンドはどちらも sudo が付く。
# `&&` で 1 本に繋いで sudo を前置すると 2 本目以降が root にならない
run "$p" update STUB_STDOUT=''
if printf '%s' "$calls" | grep -Fqx 'sudo apt-get update' &&
  printf '%s' "$calls" | grep -Fqx 'sudo apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade'; then
  ok 'apt-get update と full-upgrade をどちらも sudo で実行'
else
  ng 'update コマンド' "実際: $calls"
fi

# ===========================================================================
section '宣言の誤り — 存在しないパッケージ名を検出する'
# ===========================================================================
# apt は存在しない名前を含むと E: で異常終了し、Inst 行を1行も出さない。
# そのままにすると「不足なし」に見える (偽陰性) ので、nlp は終了コード 2 で落とす

p="$(make_path "$d/apt-err" apt)"
run "$p" diff STUB_STDERR='E: Unable to locate package opencode'

if [ "$rc" -eq 2 ]; then
  ok '照合コマンドが E: を返したら終了コード 2'
else
  ng '照合エラーの終了コード' "期待: 2 / 実際: $rc" "$out"
fi

if printf '%s' "$out" | grep -q '照合コマンドが異常です'; then
  ok '照合エラーの理由を報告する'
else
  ng '照合エラーの報告' "実際: $out"
fi

if printf '%s' "$out" | grep -q 'Unable to locate package opencode'; then
  ok 'apt の stderr をそのまま見せる'
else
  ng 'stderr の提示' "実際: $out"
fi

# apply も同じく落とす (黙って入るのを防ぐ)
run "$p" apply STUB_STDERR='E: Unable to locate package opencode'
if [ "$rc" -eq 2 ]; then
  ok 'apply も照合エラーで停止する'
else
  ng 'apply の照合エラー' "期待: 2 / 実際: $rc" "$out"
fi

if printf '%s' "$calls" | grep -qF 'sudo apt-get install'; then
  ng '照合エラー時は install を実行しない' "install が実行された: $calls"
else
  ok '照合エラー時は install を実行しない'
fi

# apt は不足が無くても stderr に NOTE を出さないので、
# エラー行の無い stderr では止めない
run "$p" diff STUB_STDERR='NOTE: This is only a simulation!' STUB_STDOUT='Inst bat (0.25.0-2)'
if [ "$rc" -eq 0 ]; then
  ok 'NOTE だけの stderr では正常動作する'
else
  ng 'NOTE だけの stderr' "期待: 0 / 実際: $rc" "$out"
fi

# stderr に何も出なくても、終了コードが「答え」を示さなければ落とす。
# apt は実在しない名前があると stderr へ E: を出して 100 で終わるが、
# メッセージが変わっても終了コードで捕捉できる
run "$p" diff STUB_RC=100
if [ "$rc" -eq 2 ]; then
  ok 'apt が rc=100 で終われば stderr が空でも終了コード 2'
else
  ng 'rc=100 の扱い' "期待: 2 / 実際: rc=$rc" "$out"
fi

# ===========================================================================
section 'pacman — 不足があるだけなら異常扱いしない'
# ===========================================================================
# pacman は不足パッケージがあると
#   `error: package 'foo' was not found` を stderr に出し、rc=127 で終わる。
# 「stderr に error: があれば異常」という判定のままだと、
# 不足があるだけで diff / apply が一生異常終了になる。
# backend ごとに「答えに対応する終了コード」を持つのはこのため
p="$(make_path "$d/pacman-noise" pacman)"
run "$p" diff STUB_STDOUT='man-db' STUB_RC=127 \
  STUB_STDERR='error: package '"'"'man-db'"'"' was not found'

if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -qE 'missing +1'; then
  ok 'package ... was not found は異常として扱わない'
else
  ng 'pacman の通常の error 行' "期待: rc=0 / missing 1 / 実際: rc=$rc" "$out"
fi

# 環境側の異常は落とす。判別は宣言側ではなく pm のメッセージ形状で行う
run "$p" diff STUB_STDERR='error: could not lock database' STUB_RC=1
if [ "$rc" -eq 2 ]; then
  ok 'could not lock database は異常として落とす'
else
  ng 'pacman の異常 stderr' "期待: 2 / 実際: rc=$rc" "$out"
fi

# ===========================================================================
section '引数 — help と見itifない引数'
# ===========================================================================
p="$(make_path "$d/args" pacman)"

run_args "$p" diff --help
if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -q 'usage: nix run'; then
  ok '--help は usage を出して終了コード 0'
else
  ng '--help' "期待: rc=0 / 実際: rc=$rc" "$out"
fi

# app ラッパーは第 1 引数にコマンド名を固定するので、
# `nix run .#diff -- --help` では $1 が diff、$2 が --help になる
run_args "$p" status --help
if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -q 'usage: nix run'; then
  ok '2 番目の引数でも --help を拾う'
else
  ng '第 2 引数の --help' "期待: rc=0 / 実際: rc=$rc" "$out"
fi

# 打った覚えのない引数は黙って無視しない
run_args "$p" diff --install
if [ "$rc" -eq 2 ] && printf '%s' "$out" | grep -q 'unexpected argument'; then
  ok '未知の引数は終了コード 2'
else
  ng '未知の引数' "期待: rc=2 / 実際: rc=$rc" "$out"
fi

# ===========================================================================
section 'root 権限 — sudo が無い環境'
# ===========================================================================
# 素のコマンドへフォールバックしない。黙って非 root で入れるほうが事故になる
p="$(make_path "$d/nosudo" pacman)"
rm -f "$d/nosudo/sudo"
run "$p" apply STUB_STDOUT='man-db' STUB_RC=127
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'sudo が見つかりません'; then
  ok 'sudo が無ければ理由を明示して落とす'
else
  ng 'sudo 不在' "期待: 落下 / 実際: rc=$rc" "$out"
fi

if printf '%s' "$calls" | grep -qF 'pacman -S --needed'; then
  ng 'sudo 不在でも install を実行しない' "install が実行された: $calls"
else
  ok 'sudo 不在でも install を実行しない'
fi

# ===========================================================================
section 'dnf — 不足判定は rpm -q の充足名から反転'
#   declare は man-pages bash-completion
# ===========================================================================
p="$(make_path "$d/dnf" dnf)"
run "$p" diff STUB_STDOUT='bash-completion' STUB_STDERR='package man-pages is not installed'

if printf '%s' "$calls" | grep -Fqx "rpm -q --qf '%{NAME}\\n' bash-completion man-pages"; then
  ok 'rpm -q に宣言を渡す (ソート済み)'
else
  ng 'rpm -q の引数' "実際: $calls"
fi

if printf '%s' "$calls" | grep -Fqx "rpm -qa --userinstalled --qf '%{NAME}\\n'"; then
  ok '明示導入は userinstalled'
else
  ng 'explicit コマンド' "実際: $calls"
fi

if printf '%s' "$out" | grep -qE 'missing +1' && printf '%s' "$out" | grep -qE '^ +- man-pages$'; then
  ok '充足名を引いて不足名を求める'
else
  ng '不足判定' "期待: man-pages / 実際: $out"
fi

run "$p" diff STUB_STDOUT='' STUB_STDERR='package bash-completion is not installed'
if printf '%s' "$out" | grep -qE 'missing +2'; then
  ok 'rpm の出力が空なら宣言全体が不足'
else
  ng '全不足判定' "期待: 2 / 実際: $out"
fi

run "$p" apply STUB_STDOUT='bash-completion' STUB_STDERR='package man-pages is not installed'
if printf '%s' "$calls" | grep -Fqx 'sudo dnf install -y man-pages'; then
  ok '不足だけを dnf install に渡す'
else
  ng 'install コマンド' "実際: $calls"
fi

run "$p" update STUB_STDOUT=''
if printf '%s' "$calls" | grep -Fqx 'sudo dnf upgrade -y'; then
  ok 'dnf upgrade -y を実行'
else
  ng 'update コマンド' "実際: $calls"
fi

# ===========================================================================
section 'zypper — declare は man bash-completion'
# ===========================================================================
p="$(make_path "$d/zypper" zypper)"

run "$p" diff STUB_STDOUT='man' STUB_STDERR='package bash-completion is not installed'
if printf '%s' "$out" | grep -qE 'missing +1' && printf '%s' "$out" | grep -qE '^ +- bash-completion$'; then
  ok 'zypper の不足判定'
else
  ng 'zypper 不足判定' "期待: bash-completion / 実際: $out"
fi

run "$p" apply STUB_STDOUT='man' STUB_STDERR='package bash-completion is not installed'
if printf '%s' "$calls" | grep -Fqx 'sudo zypper --non-interactive install -y bash-completion'; then
  ok 'zypper install に不足だけを渡す'
else
  ng 'zypper install' "実際: $calls"
fi

run "$p" update STUB_STDOUT=''
if printf '%s' "$calls" | grep -Fqx 'sudo zypper --non-interactive update'; then
  ok 'zypper update を実行'
else
  ng 'zypper update' "実際: $calls"
fi

# ===========================================================================
section 'yum — 明示導入に userinstalled を使わない (RHEL 7 には無い)'
# ===========================================================================
p="$(make_path "$d/yum" yum)"

run "$p" diff STUB_STDOUT='' STUB_STDERR='package bash-completion is not installed'
if printf '%s' "$calls" | grep -Fqx "rpm -qa --qf '%{NAME}\\n'"; then
  ok 'rpm -qa (userinstalled なし) を使う'
else
  ng 'yum explicit' "実際: $calls"
fi
if printf '%s' "$calls" | grep -q 'userinstalled'; then
  ng 'userinstalled を参照しない' "実際: $calls"
else
  ok 'userinstalled を参照しない'
fi

run "$p" apply STUB_STDOUT='' STUB_STDERR='package bash-completion is not installed'
if printf '%s' "$calls" | grep -Fqx 'sudo yum install -y bash-completion man'; then
  ok 'yum install に不足を渡す'
else
  ng 'yum install' "実際: $calls"
fi

run "$p" update STUB_STDOUT=''
if printf '%s' "$calls" | grep -Fqx 'sudo yum update -y'; then
  ok 'yum update -y を実行'
else
  ng 'yum update' "実際: $calls"
fi

# ===========================================================================
section '全 pm — remove / autoremove を実行しない'
# ===========================================================================
for pm in pacman apt dnf zypper yum; do
  p="$(make_path "$d/noremove-$pm" "$pm")"
  run "$p" update STUB_STDOUT='' STUB_RC=0
  if printf '%s' "$calls" | grep -Eqi '(remove|purge|autoremove|orphans)'; then
    ng "$pm は削除系コマンドを呼ばない" "実際: $calls"
  else
    ok "$pm は削除系コマンドを呼ばない"
  fi
done

# ===========================================================================
section 'ホスト判定'
# ===========================================================================
empty="$(mktemp -d)"
run "$empty" diff
if [ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q 'パッケージマネージャーがありません'; then
  ok 'pm 未検出で終了コード 1'
else
  ng 'pm 未検出' "期待: rc=1 / 実際: rc=$rc" "$out"
fi

p="$(make_path "$d/bogus" pacman)"
run "$p" bogus
if [ "$rc" -eq 2 ] && printf '%s' "$out" | grep -q 'unknown command'; then
  ok '不明なコマンドは終了コード 2'
else
  ng '不明なコマンド' "期待: rc=2 / 実際: rc=$rc" "$out"
fi

p="$(make_path "$d/status" pacman)"
run "$p" status
# status は宣言件数と検出結果だけを見るので、pm に照会しない。
# ここで pacman -T / -Qqe を呼ぶと「副作用なし」の意味が壊れる
if [ -z "$calls" ]; then
  ok 'status は pm コマンドを呼ばない'
else
  ng 'status は pm を呼ばない' "実際: $calls"
fi
if printf '%s' "$out" | grep -qE 'pacman +pacman@/'; then
  ok 'status に実行ファイルのパスが出る'
else
  ng 'status の表示' "実際: $out"
fi
if printf '%s' "$out" | grep -qE 'apt +\(not found\)'; then
  ok 'status は未導入の pm も一覧する'
else
  ng 'status の未検出 pm' "実際: $out"
fi

# ===========================================================================
section 'adopt — 明示導入済みを宣言の雛形として出す'
# ===========================================================================
# 契約は 3 つ。
#   1 標準出力は Nix のリストだけ。人が読む行はすべて標準エラー
#   2 照会が壊れていれば空のリストを出さない (「導入済み 0 件」は嘘になる)
#   3 宣言検査 (nix/lib/names.nix) を通さない名前は宣言に入れない。
#     そしてそれを標準エラーに列挙する
p="$(make_path "$d/adopt" pacman)"

run_split "$p" adopt STUB_STDOUT='vim
git
man-db'

if [ "$rc" -eq 0 ]; then
  ok 'adopt は終了コード 0'
else
  ng 'adopt の終了コード' "期待: 0 / 実際: rc=$rc" "$err"
fi

if printf '%s' "$calls" | grep -Fqx 'pacman -Qqe'; then
  ok '明示導入を pacman -Qqe で照会する'
else
  ng 'adopt の照会コマンド' "実際: $calls"
fi

# 副作用なし。照会以外のコマンドは出ない
if printf '%s' "$calls" | grep -qvFqx 'pacman -Qqe'; then
  ng 'adopt は照会しか呼ばない' "照会以外が呼ばれた: $calls"
else
  ok 'adopt は照会しか呼ばない'
fi

if printf '%s' "$calls" | grep -qE '(^| )(sudo|pacman -S|pacman -Sy)'; then
  ng 'adopt は sudo / install を呼ばない' "実際: $calls"
else
  ok 'adopt は sudo / install を呼ばない'
fi

# 標準出力が「宣言そのもの」であること。
# 人が読む 1 行でも混ざると `adopt > packages/<pm>.nix` が壊れる
if printf '%s\n' "$out" | grep -qE '^(  (adopt|diff|注意|lookup))' || printf '%s' "$out" | grep -q ' · '; then
  ng '標準出力に人が読む行が混ざらない' "混ざっている: $out"
else
  ok '標準出力に人が読む行が混ざらない'
fi

if printf '%s\n' "$out" | grep -qFx '[' && printf '%s\n' "$out" | grep -qFx ']'; then
  ok '標準出力が Nix のリストになる'
else
  ng '標準出力のリスト' "期待: [ ... ] / 実際: $out"
fi

for want in vim git man-db; do
  if printf '%s\n' "$out" | grep -qFx "  \"$want\""; then
    ok "明示導入済みを宣言に入れる ($want)"
  else
    ng "宣言の中身 ($want)" "実際: $out"
  fi
done

# 生成したファイルがそのまま packages/<pm>.nix として使えること。
# 照合コマンドの説明はコメントとして入る
if printf '%s\n' "$out" | grep -qFx '# packages/pacman.nix — pacman で導入するパッケージ'; then
  ok 'ヘッダにファイル名と pm 名が出る'
else
  ng 'ヘッダ' "実際: $out"
fi

if printf '%s\n' "$out" | grep -q '照合は `pacman -T` で行います。'; then
  ok '照合コマンドの説明をコメントに書く'
else
  ng '照合コマンドの説明' "実際: $out"
fi

# この nlp は 5 pm 全部に宣言が入っているので、注意が出る。
# 出力には「上書きはしない」としか書いていない
if printf '%s' "$err" | grep -q '既に 2 件の宣言があります'; then
  ok '既存の宣言件数を知らせる (上書き防止)'
else
  ng '既存宣言の警告' "期待: 既に 2 件 / 実際: $err"
fi

# --- 宣言検査を通さない名前は入らない ---
# pm の出力を信用しない。$(touch PWNED) や空白つき名前が混ざっていても
# 実行が起きず、宣言にも残らない
run_split "$p" adopt STUB_STDOUT='vim
$(touch PWNED)
a b
x; touch PWNED
man-db'

if [ -e PWNED ]; then
  ng 'adopt で PWNED が作られない' "ファイルが作られた: $(ls -1 PWNED* 2>/dev/null)"
else
  ok 'adopt は宣言からコマンドを一切実行しない'
fi

if printf '%s\n' "$out" | grep -qE '(PWNED|a b|touch)'; then
  ng 'pm が受理できない名前は宣言に入れない' "混入した: $out"
else
  ok 'pm が受理できない名前は宣言に入れない'
fi

if printf '%s\n' "$out" | grep -qFx '  "vim"' && printf '%s\n' "$out" | grep -qFx '  "man-db"'; then
  ok '受理できる名前だけを残す'
else
  ng '受理できる名前の残り' "実際: $out"
fi

# 黙って落とさない。落ちた名前は標準エラーに列挙する
if printf '%s' "$err" | grep -q 'pm が受理できないパッケージ名を宣言から外しました'; then
  ok '除外した名前を知らせる'
else
  ng '除外した名前の報告' "実際: $err"
fi

if printf '%s' "$err" | grep -qF '$(touch PWNED)'; then
  ok '除外した名前を 1 行ずつ見せる'
else
  ng '除外した名前の一覧' "実際: $err"
fi

# --- 壊れた答えで空の宣言を作らない ---
# 照会に失敗したまま [ ] を出すと、それが「導入済み 0 件」の宣言になる。
# diff が常に「不足なし」になる嘘なので、終了コード 2 で止める
run_split "$p" adopt STUB_RC=1

if [ "$rc" -eq 2 ]; then
  ok '照会が失敗したら終了コード 2'
else
  ng '照会失敗の終了コード' "期待: 2 / 実際: rc=$rc"
fi

if printf '%s' "$out" | grep -qF '['; then
  ng '照会失敗時はリストを出さない' "リストが出た: $out"
else
  ok '照会失敗時はリストを出さない'
fi

if printf '%s' "$err" | grep -q '明示導入の照会が失敗しました'; then
  ok '照会失敗の理由を報告する'
else
  ng '照会失敗の報告' "実際: $err"
fi

# stderr に何か出ているなら、pm の stderr をそのまま見せる
run_split "$p" adopt STUB_RC=1 STUB_STDERR='error: could not open database'
if printf '%s' "$err" | grep -q 'could not open database'; then
  ok 'pm の stderr をそのまま見せる'
else
  ng 'pm の stderr の提示' "実際: $err"
fi

# --- 答えが空でも rc=0 なら「導入済み 0 件」は正直な答え ---
# rc=0 で 1 件も返らないのは、素のシステムならあり得る状態。
# 黙って空の宣言にはせず、知らせる
run_split "$p" adopt STUB_STDOUT='' STUB_RC=0

if [ "$rc" -eq 0 ]; then
  ok 'rc=0 で空なら正常終了する'
else
  ng 'rc=0 空の扱い' "期待: 0 / 実際: rc=$rc" "$err"
fi

if printf '%s\n' "$out" | grep -qFx ']' && ! printf '%s\n' "$out" | grep -q '  "'; then
  ok '空のときもリストの形は崩さない'
else
  ng '空リストの形' "実際: $out"
fi

if printf '%s' "$err" | grep -q '明示導入済みが 1 個も返りませんでした'; then
  ok '空の答えを知らせる'
else
  ng '空の答えの報告' "実際: $err"
fi

# ===========================================================================
section '宣言の検証を迂回しても何も実行されない'
# ===========================================================================
# 宣言の検証 (nix/lib/declared.nix) が 1 枚目、埋め込みの引用符と
# eval 不使用が 2 枚目。hostile 版 nlp は検証を意図的に飛ばして作るので、
# 「1 枚目が壊れても 2 枚目で止まる」ことを実測する。
#
# hostile の宣言: `$(touch PWNED)` / `a b` / `'quoted'` / `x; touch PWNED`
if [ -z "$hostile" ] || [ ! -x "$hostile" ]; then
  ng 'hostile nlp が無い' 'NLP_HOSTILE=/nix/store/...-hostile/bin/nlp を渡すこと'
else
  p="$(make_path "$d/hostile" pacman)"

  # diff は「副作用なし」を謳っているコマンド。まずここが安全であること
  run_hostile "$p" diff STUB_ARGV=1 STUB_STDOUT='' STUB_RC=0
  if [ -e PWNED ]; then
    ng 'diff で PWNED が作られない' "ファイルが作られた: $(ls -1 PWNED*)"
  else
    ok 'diff は宣言からコマンドを一切実行しない'
  fi

  # 引数が 1 個ずつ决心されていること。空白で裂けていないことの確認
  if printf '%s\n' "$calls" | grep -Fqx '  ARG $(touch PWNED)'; then
    ok '$(touch PWNED) は 1 引数として渡る'
  else
    ng 'コマンド置換つきの引数' "実際: $calls"
  fi
  if printf '%s\n' "$calls" | grep -Fqx '  ARG a b'; then
    ok '空白つきの名前は 1 引数として渡る'
  else
    ng '空白つきの引数' "実際: $calls"
  fi
  if printf '%s\n' "$calls" | grep -Fqx "  ARG 'quoted'"; then
    ok 'シングルクォートつきの名前は 1 引数として渡る'
  else
    ng 'クォートつきの引数' "実際: $calls"
  fi

  # apply は eval を使わない。`; touch PWNED` が 2 本目のコマンドにならない
  run_hostile "$p" apply STUB_STDOUT='man-db' STUB_RC=127
  if [ -e PWNED ]; then
    ng 'apply で PWNED が作られない' "ファイルが作られた: $(ls -1 PWNED*)"
  else
    ok 'apply も eval を使わないので ; が命令の区切りにならない'
  fi
fi

rm -rf "$d" PWNED

printf '\n'
if [ "$fail" -eq 0 ]; then
  printf '  \033[32mall %d passed\033[0m\n' "$total"
  exit 0
fi
printf '  \033[31m%d / %d failed\033[0m\n' "$fail" "$total"
exit 1
