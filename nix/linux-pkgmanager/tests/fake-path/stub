#!/bin/sh
# tests/fake-path/stub — pm コマンドのスタブ
#
# 引数と呼び出し順を 1行ずつ標準出力に吐いて終了する。
# 実行の副作用は一切しない (sudo を呼ばれた場合も同様)。
#
# 環境変数で挙動を切り替える:
#   STUB_LOG     呼び出し記録の出力先 (既定: 標準出力)
#   STUB_STDOUT  呼び出し記録とは別に出したい内容 (改行区切り)
#   STUB_STDERR  さらに標準エラーに出したい内容
#   STUB_RC      終了コード (既定: 0)
#   STUB_ARGV    1 にすると、引数を 1行ずつ "  ARG <値>" として出す。
#                引数が 1 個の単位のまま保たれることを確かめるのに使う
#                (空白や $ を含む宣言名を「1 引数」として渡せているかの確認)
#
# PATH に bash も coreutils も無い状態で呼ばれる前提なので、
# shebang は /bin/sh、名前解決は外部コマンドを使わない
# (パラメータ展開だけで取り出す)。
set -u

name="${0##*/}"

log="${STUB_LOG:-}"

if [ -n "$log" ]; then
  printf '%s' "$name" >>"$log"
  for a in "$@"; do
    printf ' %s' "$a" >>"$log"
  done
  printf '\n' >>"$log"

  if [ -n "${STUB_ARGV:-}" ]; then
    for a in "$@"; do
      printf '  ARG %s\n' "$a" >>"$log"
    done
    printf '  END\n' >>"$log"
  fi
else
  printf '%s' "$name"
  for a in "$@"; do
    printf ' %s' "$a"
  done
  printf '\n'

  if [ -n "${STUB_ARGV:-}" ]; then
    for a in "$@"; do
      printf '  ARG %s\n' "$a"
    done
    printf '  END\n'
  fi
fi

# 呼び出し記録と分けて返したい内容
if [ -n "${STUB_STDOUT:-}" ]; then
  printf '%s\n' "$STUB_STDOUT"
fi

if [ -n "${STUB_STDERR:-}" ]; then
  printf '%s\n' "$STUB_STDERR" >&2
fi

# sudo は pm コマンドではないので STUB_RC を反映しない。
# 実際の `sudo -v` は常に 0 を返すので、ここが 127 を返すと
# 生成スクリプト側の set -e が誤作動して途中で落ちる
rc="${STUB_RC:-0}"
if [ "$name" = sudo ]; then
  rc=0
fi

exit "$rc"