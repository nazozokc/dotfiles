{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@earendil-works/*": ["./node_modules/@earendil-works/*"],
      "typebox": ["./node_modules/typebox"]
    }
  },
  "include": ["./extensions/**/*.ts", "./load-test.ts", "./render-test.ts"]
}
