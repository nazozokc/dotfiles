{
  // Windows Terminal settings (Dev channel)
  // Auto-linked to: %USERPROFILE%\.config\wt\settings.json
  //
  // Store version: Copy to
  //   %LOCALAPPDATA%\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json

  "$schema": "https://aka.ms/terminal-profiles-schema",

  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",

  "profiles": {
    "defaults": {
      "font": {
        "face": "JetBrainsMono Nerd Font",
        "size": 11
      },
      "colorScheme": "Kanagawa",
      "opacity": 90,
      "useAcrylic": true,
      "cursorShape": "vintage",
      "cursorHeight": 25,
      "antialiasingMode": "grayscale",
      "bellStyle": "none",
      "closeOnExit": "graceful",
      "scrollbarState": "hidden"
    },
    "list": [
      {
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "name": "PowerShell 7",
        "commandline": "pwsh.exe -nologo",
        "startingDirectory": ".",
        "icon": "https://raw.githubusercontent.com/PowerShell/PowerShell/master/assets/ps_black_128.svg"
      },
      {
        "guid": "{2c4de342-38b7-51cf-b940-2309a097f489}",
        "name": "Windows PowerShell",
        "commandline": "powershell.exe -nologo",
        "source": "Windows.Terminal.WindowsPowerShell",
        "hidden": true
      },
      {
        "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
        "name": "Command Prompt",
        "commandline": "cmd.exe",
        "hidden": true
      }
    ]
  },

  "schemes": [
    {
      "name": "Kanagawa",
      "background": "#1F1F28",
      "foreground": "#DCD7BA",
      "black": "#090A0E",
      "blue": "#7FB4CA",
      "brightBlack": "#727169",
      "brightBlue": "#7FB4CA",
      "brightCyan": "#6A9589",
      "brightGreen": "#98BB6C",
      "brightPurple": "#957FB8",
      "brightRed": "#C4746E",
      "brightWhite": "#C8C09C",
      "brightYellow": "#C4A000",
      "cyan": "#6A9589",
      "green": "#76946A",
      "purple": "#957FB8",
      "red": "#E46876",
      "white": "#C8C094",
      "yellow": "#DCA561"
    }
  ],

  "actions": [
    // -- Tabs --
    { "command": "newTab", "keys": "ctrl+shift+t" },
    { "command": { "action": "nextTab" }, "keys": "ctrl+shift+]" },
    { "command": { "action": "prevTab" }, "keys": "ctrl+shift+[" },
    { "command": "closePane", "keys": "ctrl+w" },
    { "command": "openNewTabDropdown", "keys": "ctrl+t" },

    // -- Panes --
    {
      "command": { "action": "splitPane", "split": "vertical" },
      "keys": "alt+shift+-"
    },
    {
      "command": { "action": "splitPane", "split": "horizontal" },
      "keys": "alt+shift+="
    },
    {
      "command": { "action": "splitPane", "split": "auto" },
      "keys": "ctrl+shift+\\"
    },
    {
      "command": { "action": "moveFocus", "direction": "left" },
      "keys": "alt+left"
    },
    {
      "command": { "action": "moveFocus", "direction": "right" },
      "keys": "alt+right"
    },
    {
      "command": { "action": "moveFocus", "direction": "up" },
      "keys": "alt+up"
    },
    {
      "command": { "action": "moveFocus", "direction": "down" },
      "keys": "alt+down"
    },
    {
      "command": { "action": "resizePane", "direction": "left" },
      "keys": "ctrl+shift+left"
    },
    {
      "command": { "action": "resizePane", "direction": "right" },
      "keys": "ctrl+shift+right"
    },
    {
      "command": { "action": "resizePane", "direction": "up" },
      "keys": "ctrl+shift+up"
    },
    {
      "command": { "action": "resizePane", "direction": "down" },
      "keys": "ctrl+shift+down"
    },

    // -- Search / find --
    { "command": { "action": "find" }, "keys": "ctrl+shift+f" },

    // -- Display --
    { "command": "toggleFullscreen", "keys": "ctrl+shift+f11" },
    { "command": { "action": "quakeMode" }, "keys": "ctrl+`" },
    { "command": { "action": "togglePaneZoom" }, "keys": "ctrl+shift+space" },

    // -- Send text shortcuts —
    {
      "command": { "action": "sendInput", "input": "gs\n" },
      "keys": "ctrl+shift+g"
    },

    // -- Clipboard —
    { "command": { "action": "copy", "singleLine": false }, "keys": "ctrl+c" },
    { "command": { "action": "paste" }, "keys": "ctrl+v" }
  ],

  // -- Global settings —
  "alwaysShowTabs": true,
  "showTabsInTitlebar": true,
  "showTerminalTitle": false,
  "tabSwitcherMode": "disabled",
  "confirmCloseAllTabs": false,
  "initialCols": 120,
  "initialRows": 36,
  "launchMode": "default",
  "copyOnSelect": true,
  "copyFormatting": "none",
  "windowingBehavior": "useExisting",
  "disableAnimations": false,
  "startOnUserLogin": true,
  "theme": "dark",
  "useAcrylicInTabRow": true,
  "centerOnLaunch": true,
  "showExitMessage": false,
  "firstWindowPreference": "defaultProfile"
}
